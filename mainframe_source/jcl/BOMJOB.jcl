//BOMJOB   JOB (MFGACCT),'BOM EXPLOSION',CLASS=A,
//         MSGCLASS=X,MSGLEVEL=(1,1),NOTIFY=&SYSUID
//*================================================================*
//* BOMJOB - BOM EXPLOSION AND COSTED ROLLUP                        *
//*                                                                  *
//* RUNS ON-DEMAND OR NIGHTLY FOR PRODUCTION PLANNING.               *
//* INPUT: LIST OF PARENT ASSEMBLIES TO EXPLODE                      *
//* OUTPUT: MULTI-LEVEL BOM REPORT + COSTED ROLLUP SUMMARY          *
//*================================================================*
//*
//JOBLIB   DD  DSN=MFG.PROD.LOADLIB,DISP=SHR
//         DD  DSN=IMS.RESLIB,DISP=SHR
//*
//BOMEXPL  EXEC PGM=DFSRRC00,
//         PARM='DLI,BOMEXPL,MFGPSB'
//STEPLIB  DD  DSN=IMS.RESLIB,DISP=SHR
//         DD  DSN=MFG.PROD.LOADLIB,DISP=SHR
//IMS      DD  DSN=IMS.PSBLIB,DISP=SHR
//         DD  DSN=IMS.DBDLIB,DISP=SHR
//DFSRESLB DD  DSN=IMS.RESLIB,DISP=SHR
//DFSVSAMP DD  DSN=IMS.PROCLIB(DFSVSMHP),DISP=SHR
//IEFRDER  DD  DSN=MFG.IMS.LOG(&RUNDATE),DISP=(NEW,CATLG),
//         UNIT=SYSDA,SPACE=(CYL,(5,2),RLSE),
//         DCB=(RECFM=VB,LRECL=6144,BLKSIZE=6148)
//*
//BOMREQ   DD  DSN=MFG.INPUT.BOMREQUEST,DISP=SHR
//BOMRPT   DD  DSN=MFG.REPORTS.BOMEXPLOSION(+1),
//         DISP=(NEW,CATLG),
//         UNIT=SYSDA,SPACE=(TRK,(30,10),RLSE),
//         DCB=(RECFM=FB,LRECL=132,BLKSIZE=27984)
//COSTRPT  DD  DSN=MFG.REPORTS.COSTROLLUP(+1),
//         DISP=(NEW,CATLG),
//         UNIT=SYSDA,SPACE=(TRK,(10,5),RLSE),
//         DCB=(RECFM=FB,LRECL=132,BLKSIZE=27984)
//SYSOUT   DD  SYSOUT=*
//SYSUDUMP DD  SYSOUT=*
//
