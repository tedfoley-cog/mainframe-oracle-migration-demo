//NIGHTRUN JOB (MFGACCT),'NIGHTLY BATCH',CLASS=A,
//         MSGCLASS=X,MSGLEVEL=(1,1),NOTIFY=&SYSUID,
//         TYPRUN=SCAN
//*================================================================*
//* NIGHTRUN - NIGHTLY MANUFACTURING BATCH ORCHESTRATOR             *
//*                                                                  *
//* MASTER JOB THAT ORCHESTRATES THE NIGHTLY BATCH CYCLE:            *
//*   STEP 1: PARTS INVENTORY PROCESSING                             *
//*   STEP 2: BOM EXPLOSION FOR NEXT-DAY BUILD SCHEDULE             *
//*   STEP 3: SUPPLIER EDI PROCESSING (INBOUND ASN)                 *
//*   STEP 4: QUALITY CONTROL INSPECTION RESULTS                    *
//*   STEP 5: WARRANTY CLAIMS SETTLEMENT                            *
//*   STEP 6: DB2 STATISTICS REFRESH                                 *
//*                                                                  *
//* SCHEDULING: TIDAL WORKLOAD AUTOMATION, 22:00 CST DAILY           *
//* DEPENDENCY: ONLINE IMS REGION MUST BE QUIESCED BEFORE START     *
//* SLA: MUST COMPLETE BEFORE 05:00 CST FOR MORNING SHIFT           *
//*================================================================*
//*
//JOBLIB   DD  DSN=MFG.PROD.LOADLIB,DISP=SHR
//         DD  DSN=IMS.RESLIB,DISP=SHR
//         DD  DSN=DB2.SDSNLOAD,DISP=SHR
//*
//*------- STEP 1: PARTS INVENTORY ------*
//*
//STEP01   EXEC PGM=DFSRRC00,
//         PARM='DLI,PARTINV,MFGPSB'
//STEPLIB  DD  DSN=IMS.RESLIB,DISP=SHR
//         DD  DSN=MFG.PROD.LOADLIB,DISP=SHR
//IMS      DD  DSN=IMS.PSBLIB,DISP=SHR
//         DD  DSN=IMS.DBDLIB,DISP=SHR
//DFSRESLB DD  DSN=IMS.RESLIB,DISP=SHR
//DFSVSAMP DD  DSN=IMS.PROCLIB(DFSVSMHP),DISP=SHR
//IEFRDER  DD  DSN=MFG.IMS.LOG.NIGHTLY(&RUNDATE),
//         DISP=(NEW,CATLG),
//         UNIT=SYSDA,SPACE=(CYL,(10,5),RLSE),
//         DCB=(RECFM=VB,LRECL=6144,BLKSIZE=6148)
//INVTRANS DD  DSN=MFG.DAILY.INVTRANS,DISP=SHR
//INVRPT   DD  DSN=MFG.REPORTS.INVVAL(+1),DISP=(NEW,CATLG),
//         UNIT=SYSDA,SPACE=(TRK,(20,5),RLSE),
//         DCB=(RECFM=FB,LRECL=132,BLKSIZE=27984)
//EXCPRPT  DD  SYSOUT=*
//SYSOUT   DD  SYSOUT=*
//SYSUDUMP DD  SYSOUT=*
//*
//*------- STEP 2: BOM EXPLOSION ------*
//*
//STEP02   EXEC PGM=DFSRRC00,
//         PARM='DLI,BOMEXPL,MFGPSB',
//         COND=(0,NE,STEP01)
//STEPLIB  DD  DSN=IMS.RESLIB,DISP=SHR
//         DD  DSN=MFG.PROD.LOADLIB,DISP=SHR
//IMS      DD  DSN=IMS.PSBLIB,DISP=SHR
//         DD  DSN=IMS.DBDLIB,DISP=SHR
//DFSRESLB DD  DSN=IMS.RESLIB,DISP=SHR
//DFSVSAMP DD  DSN=IMS.PROCLIB(DFSVSMHP),DISP=SHR
//IEFRDER  DD  DSN=MFG.IMS.LOG.BOM(&RUNDATE),
//         DISP=(NEW,CATLG),
//         UNIT=SYSDA,SPACE=(CYL,(5,2),RLSE),
//         DCB=(RECFM=VB,LRECL=6144,BLKSIZE=6148)
//BOMREQ   DD  DSN=MFG.INPUT.BOMREQUEST,DISP=SHR
//BOMRPT   DD  DSN=MFG.REPORTS.BOMEXPLOSION(+1),
//         DISP=(NEW,CATLG),
//         UNIT=SYSDA,SPACE=(TRK,(30,10),RLSE),
//         DCB=(RECFM=FB,LRECL=132,BLKSIZE=27984)
//COSTRPT  DD  DSN=MFG.REPORTS.COSTROLLUP(+1),
//         DISP=(NEW,CATLG),
//         UNIT=SYSDA,SPACE=(TRK,(10,5),RLSE),
//         DCB=(RECFM=FB,LRECL=132,BLKSIZE=27984)
//SYSOUT   DD  SYSOUT=*
//SYSUDUMP DD  SYSOUT=*
//*
//*------- STEP 3: SUPPLIER EDI ------*
//*
//STEP03   EXEC PGM=DFSRRC00,
//         PARM='DLI,SUPPEDI,MFGPSB',
//         COND=(0,NE,STEP01)
//STEPLIB  DD  DSN=IMS.RESLIB,DISP=SHR
//         DD  DSN=MFG.PROD.LOADLIB,DISP=SHR
//IMS      DD  DSN=IMS.PSBLIB,DISP=SHR
//         DD  DSN=IMS.DBDLIB,DISP=SHR
//DFSRESLB DD  DSN=IMS.RESLIB,DISP=SHR
//DFSVSAMP DD  DSN=IMS.PROCLIB(DFSVSMHP),DISP=SHR
//IEFRDER  DD  DSN=MFG.IMS.LOG.EDI(&RUNDATE),
//         DISP=(NEW,CATLG),
//         UNIT=SYSDA,SPACE=(CYL,(5,2),RLSE),
//         DCB=(RECFM=VB,LRECL=6144,BLKSIZE=6148)
//EDIIN    DD  DSN=MFG.EDI.INBOUND.QUEUE,DISP=SHR
//EDIOUT   DD  DSN=MFG.EDI.OUTBOUND(&RUNDATE),
//         DISP=(NEW,CATLG),
//         UNIT=SYSDA,SPACE=(TRK,(20,5),RLSE),
//         DCB=(RECFM=VB,LRECL=1028,BLKSIZE=6148)
//EDILOG   DD  SYSOUT=*
//SYSOUT   DD  SYSOUT=*
//SYSUDUMP DD  SYSOUT=*
//*
//*------- STEP 4: QUALITY CONTROL ------*
//*
//STEP04   EXEC PGM=DFSRRC00,
//         PARM='DLI,QUALCTL,MFGPSB',
//         COND=(0,NE,STEP01)
//STEPLIB  DD  DSN=IMS.RESLIB,DISP=SHR
//         DD  DSN=MFG.PROD.LOADLIB,DISP=SHR
//IMS      DD  DSN=IMS.PSBLIB,DISP=SHR
//         DD  DSN=IMS.DBDLIB,DISP=SHR
//DFSRESLB DD  DSN=IMS.RESLIB,DISP=SHR
//DFSVSAMP DD  DSN=IMS.PROCLIB(DFSVSMHP),DISP=SHR
//IEFRDER  DD  DSN=MFG.IMS.LOG.QUAL(&RUNDATE),
//         DISP=(NEW,CATLG),
//         UNIT=SYSDA,SPACE=(CYL,(5,2),RLSE),
//         DCB=(RECFM=VB,LRECL=6144,BLKSIZE=6148)
//QUALIN   DD  DSN=MFG.QUALITY.INSPECTIONS,DISP=SHR
//NCRRPT   DD  DSN=MFG.REPORTS.NCR(+1),DISP=(NEW,CATLG),
//         UNIT=SYSDA,SPACE=(TRK,(10,5),RLSE),
//         DCB=(RECFM=FB,LRECL=132,BLKSIZE=27984)
//SCUPDT   DD  DSN=MFG.REPORTS.SCORECARD(+1),
//         DISP=(NEW,CATLG),
//         UNIT=SYSDA,SPACE=(TRK,(5,2),RLSE),
//         DCB=(RECFM=FB,LRECL=132,BLKSIZE=27984)
//SYSOUT   DD  SYSOUT=*
//SYSUDUMP DD  SYSOUT=*
//*
//*------- STEP 5: WARRANTY CLAIMS ------*
//*
//STEP05   EXEC PGM=DFSRRC00,
//         PARM='DLI,WARRCLS,MFGPSB',
//         COND=(0,NE,STEP01)
//STEPLIB  DD  DSN=IMS.RESLIB,DISP=SHR
//         DD  DSN=MFG.PROD.LOADLIB,DISP=SHR
//IMS      DD  DSN=IMS.PSBLIB,DISP=SHR
//         DD  DSN=IMS.DBDLIB,DISP=SHR
//DFSRESLB DD  DSN=IMS.RESLIB,DISP=SHR
//DFSVSAMP DD  DSN=IMS.PROCLIB(DFSVSMHP),DISP=SHR
//IEFRDER  DD  DSN=MFG.IMS.LOG.WARR(&RUNDATE),
//         DISP=(NEW,CATLG),
//         UNIT=SYSDA,SPACE=(CYL,(5,2),RLSE),
//         DCB=(RECFM=VB,LRECL=6144,BLKSIZE=6148)
//CLAIMSIN DD  DSN=MFG.WARRANTY.CLAIMS.DAILY,DISP=SHR
//PAYAUTH  DD  DSN=MFG.WARRANTY.PAYAUTH(+1),
//         DISP=(NEW,CATLG),
//         UNIT=SYSDA,SPACE=(TRK,(10,5),RLSE),
//         DCB=(RECFM=FB,LRECL=132,BLKSIZE=27984)
//CLMREJ   DD  SYSOUT=*
//CLMSUMM  DD  DSN=MFG.REPORTS.WARRSUMM(+1),
//         DISP=(NEW,CATLG),
//         UNIT=SYSDA,SPACE=(TRK,(5,2),RLSE),
//         DCB=(RECFM=FB,LRECL=132,BLKSIZE=27984)
//SYSOUT   DD  SYSOUT=*
//SYSUDUMP DD  SYSOUT=*
//*
//*------- STEP 6: DB2 RUNSTATS ------*
//*
//STEP06   EXEC PGM=DSNUTILB,
//         PARM='DB2P,RUNSTATS',
//         COND=(0,NE,STEP01)
//STEPLIB  DD  DSN=DB2.SDSNLOAD,DISP=SHR
//SYSPRINT DD  SYSOUT=*
//SYSIN    DD  *
  RUNSTATS TABLESPACE MFGDB.MFGTS
    TABLE (ALL) INDEX (ALL)
    SHRLEVEL CHANGE
    REPORT YES
/*
//
