//PARTJOB  JOB (MFGACCT),'PARTS INVENTORY',CLASS=A,
//         MSGCLASS=X,MSGLEVEL=(1,1),NOTIFY=&SYSUID
//*================================================================*
//* PARTJOB - NIGHTLY PARTS INVENTORY BATCH PROCESSING              *
//*                                                                  *
//* STEP 1: SORT DAILY TRANSACTIONS BY PART NUMBER                   *
//* STEP 2: RUN PARTINV TO PROCESS TRANSACTIONS                     *
//* STEP 3: COPY INVENTORY VALUATION REPORT TO GDG                  *
//*================================================================*
//*
//JOBLIB   DD  DSN=MFG.PROD.LOADLIB,DISP=SHR
//         DD  DSN=IMS.RESLIB,DISP=SHR
//*
//*------- STEP 1: SORT TRANSACTIONS ------*
//*
//SORT010  EXEC PGM=SORT
//SYSOUT   DD  SYSOUT=*
//SORTIN   DD  DSN=MFG.DAILY.INVTRANS,DISP=SHR
//SORTOUT  DD  DSN=&&SORTED,DISP=(NEW,PASS),
//         UNIT=SYSDA,SPACE=(TRK,(50,10),RLSE),
//         DCB=(RECFM=FB,LRECL=80,BLKSIZE=27920)
//SYSIN    DD  *
  SORT FIELDS=(3,15,CH,A)
  END
/*
//*
//*------- STEP 2: PROCESS INVENTORY TRANSACTIONS ------*
//*
//PARTINV  EXEC PGM=DFSRRC00,
//         PARM='DLI,PARTINV,MFGPSB'
//STEPLIB  DD  DSN=IMS.RESLIB,DISP=SHR
//         DD  DSN=MFG.PROD.LOADLIB,DISP=SHR
//IMS      DD  DSN=IMS.PSBLIB,DISP=SHR
//         DD  DSN=IMS.DBDLIB,DISP=SHR
//DFSRESLB DD  DSN=IMS.RESLIB,DISP=SHR
//DFSVSAMP DD  DSN=IMS.PROCLIB(DFSVSMHP),DISP=SHR
//IEFRDER  DD  DSN=MFG.IMS.LOG(&RUNDATE),DISP=(NEW,CATLG),
//         UNIT=SYSDA,SPACE=(CYL,(10,5),RLSE),
//         DCB=(RECFM=VB,LRECL=6144,BLKSIZE=6148)
//*
//INVTRANS DD  DSN=&&SORTED,DISP=(OLD,DELETE)
//INVRPT   DD  DSN=MFG.REPORTS.INVVAL(+1),DISP=(NEW,CATLG),
//         UNIT=SYSDA,SPACE=(TRK,(20,5),RLSE),
//         DCB=(RECFM=FB,LRECL=132,BLKSIZE=27984)
//EXCPRPT  DD  DSN=MFG.REPORTS.INVEXCPT,
//         DISP=(NEW,CATLG,DELETE),
//         UNIT=SYSDA,SPACE=(TRK,(5,2),RLSE),
//         DCB=(RECFM=FB,LRECL=132,BLKSIZE=27984)
//SYSOUT   DD  SYSOUT=*
//SYSUDUMP DD  SYSOUT=*
//*
//*------- STEP 3: ARCHIVE REPORT TO GDG ------*
//*
//ARCHIVE  EXEC PGM=IEBGENER,COND=(0,NE,PARTINV)
//SYSUT1   DD  DSN=MFG.REPORTS.INVVAL(+1),DISP=SHR
//SYSUT2   DD  DSN=MFG.ARCHIVE.INVVAL(&RUNDATE),
//         DISP=(NEW,CATLG),
//         UNIT=TAPE,
//         DCB=(RECFM=FB,LRECL=132,BLKSIZE=27984)
//SYSIN    DD  DUMMY
//SYSPRINT DD  SYSOUT=*
//
